PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/classic-boutique
JWT_SECRET=replace_with_at_least_32_random_characters
CLIENT_URL=http://localhost:5173
NODE_ENV=development
# Session token lifetime (jsonwebtoken format, e.g. 12h, 8h).
JWT_EXPIRES_IN=12h
# Reverse-proxy hops in front of the API so the real client IP is used for
# login throttling. Render: 1. Nginx on the same host: loopback.
TRUST_PROXY=1

# Optional email/report links
POS_URL=http://localhost:5173
APP_URL=http://localhost:5173
GMAIL_USER=
GMAIL_APP_PASSWORD=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=
ADMIN_EMAILS=
DEFAULT_ADMIN_EMAIL=
# Owner account: other superadmins cannot rename, demote, deactivate or delete it.
SUPER_ADMIN_EMAIL=
